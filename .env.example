# کپی این فایل به .env و مقادیر رو تنظیم کن. .env هرگز نباید commit بشه.

# production | testnet — تعیین می‌کنه کدوم base URL استفاده بشه
NOBITEX_ENV=production

NOBITEX_API_BASE_URL=https://api.nobitex.ir
NOBITEX_TESTNET_BASE_URL=https://testnetapiv2.nobitex.ir

# فقط برای endpointهای نیازمند توکن (فاز ۷ به بعد). خالی بمونه کافیه برای فاز ۱-۶.
NOBITEX_API_TOKEN=

# مسیر ذخیره‌سازی داده (SQLite و غیره) — نسبی یا مطلق، برای پرتابل بودن بین لپ‌تاپ/VPS
NOBITEX_DATA_DIR=./data

NOBITEX_LOG_LEVEL=INFO
