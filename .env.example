# کپی این فایل به .env و مقادیر رو تنظیم کن. .env هرگز نباید commit بشه.

# production | testnet — تعیین می‌کنه کدوم base URL استفاده بشه
NOBITEX_ENV=production

NOBITEX_API_BASE_URL=https://apiv2.nobitex.ir
NOBITEX_TESTNET_BASE_URL=https://testnetapiv2.nobitex.ir

# روش قدیمی احراز هویت (توکن ورود از پنل کاربری). خالی بمونه کافیه برای فاز ۱-۲.
NOBITEX_API_TOKEN=

# روش جدید و توصیه‌شدهٔ نوبیتکس: «کلید API» (پنل کاربری -> API -> ایجاد کلید API).
# اگه این دو مقدار پر باشن، اولویت با این‌هاست (نه NOBITEX_API_TOKEN).
# دسترسی لازم برای Paper Trading: READ,TRADE — هیچ‌وقت WITHDRAW فعال نشه.
NOBITEX_API_KEY=
NOBITEX_API_SECRET=

# طبق توصیهٔ مستندات نوبیتکس، برای شناسایی بهتر بات در User-Agent قرار می‌گیره
NOBITEX_BOT_NAME=PersonalBot

# مسیر ذخیره‌سازی داده (SQLite و غیره) — نسبی یا مطلق، برای پرتابل بودن بین لپ‌تاپ/VPS
NOBITEX_DATA_DIR=./data

NOBITEX_LOG_LEVEL=INFO

# فاز ۸ — داشبورد وب و امنیت
# کلید امضای session فلسک — اگه خالی بمونه هر ری‌استارت یعنی خروج اجباری از داشبورد
NOBITEX_FLASK_SECRET_KEY=

# برای اسکریپت‌های headless (مثل run_paper_trading.py) که نمی‌تونن رمز رو از
# session داشبورد بگیرن، اگه توکن API از داشبورد (رمزنگاری‌شده) ذخیره شده،
# این رمز اصلی برای بازش کردنش لازمه.
NOBITEX_MASTER_PASSWORD=
